BEGIN
{
  @agent_tids[cpid] = 1;
  printf("__EBPF_TRACKER_AGENT_READY__\n");
}

tracepoint:sched:sched_process_fork
/@agent_tids[args->parent_pid]/
{
  @agent_tids[args->child_pid] = 1;
}

tracepoint:sched:sched_process_exit
/@agent_tids[tid]/
{
  delete(@agent_open_pending[tid]);
  delete(@agent_open_files[tid]);
  delete(@agent_tids[tid]);
}

tracepoint:syscalls:sys_enter_getpid
/pid == cpid/
{
  printf("__EBPF_TRACKER_AGENT_SCOPE__%d\n", pid);
}

tracepoint:syscalls:sys_enter_execve
/@agent_tids[tid] && pid != cpid/
{
  printf("execve comm=%s pid=%d\n", comm, pid);
}

tracepoint:syscalls:sys_enter_openat
/@agent_tids[tid] && pid != cpid/
{
  // Copy the pathname while the syscall's userspace argument is valid. Each
  // thread has at most one openat in flight; workers must not share a PID key.
  @agent_open_files[tid] = str(args->filename);
  @agent_open_pending[tid] = 1;
}

tracepoint:syscalls:sys_exit_openat
/@agent_tids[tid] && pid != cpid && @agent_open_pending[tid]/
{
  $ret = args->ret;
  $errno = $ret < 0 ? -$ret : 0;
  printf("openat comm=%s pid=%d return_value=%d errno=%d file=%s\n", comm, pid, $ret, $errno, @agent_open_files[tid]);
  delete(@agent_open_pending[tid]);
  delete(@agent_open_files[tid]);
}

tracepoint:syscalls:sys_enter_write
/@agent_tids[tid] && pid != cpid/
{
  printf("write comm=%s pid=%d bytes=%d\n", comm, pid, args->count);
}

tracepoint:syscalls:sys_enter_connect
/@agent_tids[tid] && pid != cpid/
{
  printf("connect comm=%s pid=%d fd=%d\n", comm, pid, args->fd);
}

END
{
  clear(@agent_open_pending);
  clear(@agent_open_files);
  clear(@agent_tids);
}
